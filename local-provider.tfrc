provider_installation {
  filesystem_mirror {
    path = "./.tofu-provider-mirror"
    include = [
      "registry.terraform.io/houndsolo/vyos-rolling",
      "local/mechanic/proxmox",
    ]
  }

  direct {
    exclude = [
      "registry.terraform.io/houndsolo/vyos-rolling",
      "local/mechanic/proxmox",
    ]
  }
}
