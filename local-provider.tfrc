provider_installation {
  filesystem_mirror {
    path = "/home/mechanic/.terraform.d/plugins"

    include = [
      "registry.terraform.io/houndsolo/vyos-rolling",
      "local/mechanic/proxmox",
    ]
  }

  direct {
    exclude = [
      "registry.terraform.io/houndsolo/vyos-rolling",
      "local/mechanic/proxmox",
    ]
  }
}
